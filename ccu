-- TAB 1: WEAPON ROLL (SAMA DENGAN GIFT)
local RollTab = Window:CreateTab("Auto Roll", "repeat")

RollTab:CreateSection("🛡️ Anti-Lag Block System")

RollTab:CreateButton({
    Name = "🚫 Block All Lag",
    Callback = function()
        local count = blockLagEvents()
        if count then
            Rayfield:Notify({Title = "Success", Content = "Berhasil memblokir koneksi UI event pencetus lag!", Duration = 3})
        else
            Rayfield:Notify({Title = "Error", Content = "Gagal memblokir event / Executor tidak mendukung getconnections.", Duration = 3})
        end
    end,
})

RollTab:CreateSection("🎲 Auto Roll Weapon System")

RollTab:CreateInput({
    Name = "🔢 Setting Payload Roll (Default: 300)",
    PlaceholderText = "Masukkan Angka Roll (misal: 300)",
    RemoveTextAfterFocusLost = false,
    Callback = function(Text)
        local num = tonumber(Text)
        if num and num > 0 then
            rollNumber = math.floor(num)
        else
            rollNumber = 300
        end
    end,
})

RollTab:CreateInput({
    Name = "💥 Burst Count Roll Weapon (Textbox)",
    PlaceholderText = "Default: 100 (Recommended 50-100)",
    RemoveTextAfterFocusLost = false,
    Callback = function(Text)
        local num = tonumber(Text)
        if num and num > 0 then
            rollBurstAmount = math.floor(num)
        else
            rollBurstAmount = 100
        end
    end,
})

RollTab:CreateSlider({
    Name = "⏱️ Spam Roll Delay",
    Range = {0.01, 1},
    Increment = 0.01,
    Suffix = "detik",
    CurrentValue = 0.05,
    Flag = "RollDelaySlider",
    Callback = function(Value)
        rollDelay = Value
    end,
})

RollTab:CreateToggle({
    Name = "🔥 Enable Auto Roll Spam",
    CurrentValue = false,
    Flag = "AutoRollToggle",
    Callback = function(Value)
        autoRollEnabled = Value

        if autoRollEnabled then
            blockLagEvents()

            task.spawn(function()
                while autoRollEnabled do
                    if Remotes then
                        local rollWeapon = Remotes:FindFirstChild("RollWeapon")
                        if rollWeapon then
                            for i = 1, rollBurstAmount do
                                if not autoRollEnabled then break end
                                task.defer(function()
                                    pcall(function()
                                        rollWeapon:FireServer(rollNumber)
                                    end)
                                end)
                            end
                        end
                    end
                    task.wait(rollDelay)
                end
            end)
        end
    end,
})

RollTab:CreateButton({
    Name = "🎯 Test 1x Burst Roll Weapon",
    Callback = function()
        blockLagEvents()
        if Remotes then
            local rollWeapon = Remotes:FindFirstChild("RollWeapon")
