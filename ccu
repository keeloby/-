local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "vvu25",
    LoadingTitle = "Loading",
    LoadingSubtitle = "by zjzok",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false,
})

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = ReplicatedStorage:WaitForChild("Remotes", 5)

-- ==========================================
-- GLOBAL CONTROL VARIABLES
-- ==========================================
-- Roll Weapon Settings
local autoRollEnabled = false
local rollNumber = 300
local rollBurstAmount = 100
local rollDelay = 0.05

-- Claim Gift Settings
local autoGiftEnabled = false
local giftNumber = 5
local giftBurstAmount = 100
local giftDelay = 0.05

-- OP Guns Settings
local opDamage = 999999999
local opCooldown = 0
local opBullets = 10

-- ==========================================
-- ANTI-LAG / EVENT BLOCKER FUNCTION
-- ==========================================
local function blockLagEvents()
    if not Remotes or not getconnections then return false end

    local targetEvents = {"WeaponRolled", "Notify", "CashGained"}
    local blockedCount = 0

    for _, eventName in ipairs(targetEvents) do
        local remote = Remotes:FindFirstChild(eventName)
        if remote then
            for _, connection in ipairs(getconnections(remote.OnClientEvent)) do
                connection:Disable()
                blockedCount = blockedCount + 1
            end
        end
    end

    return blockedCount
end

-- ==========================================
-- OP GUNS MODIFIER FUNCTION
-- ==========================================
local function modifyGunsOP()
    local balancing = ReplicatedStorage:FindFirstChild("Balancing")
    if balancing then
        local gunsModule = balancing:FindFirstChild("Guns")
        if gunsModule then
            local gunTable = require(gunsModule)
            for gunName, stats in pairs(gunTable) do
                if type(stats) == "table" then
                    stats["Damage"] = opDamage
                    stats["Cooldown"] = opCooldown
                    stats["Automatic"] = true
                    stats["Bullets"] = opBullets
                end
            end
            return true
        end
    end
    return false
end

