-- HIDE/SHOW PLAYER EGGS LOGIC
-------------------------------------------------------------------
local hidePlayerEggsToggle = false

local function setEggVisibility(transparent)
    local player = game.Players.LocalPlayer
    local playerFriendsFolder = workspace:FindFirstChild("Live") 
        and workspace.Live:FindFirstChild("PlayerFriends")

    if not playerFriendsFolder then return end

    local myFolder = nil
    for _, folder in ipairs(playerFriendsFolder:GetChildren()) do
        if folder.Name:find(player.Name) or folder.Name:find(tostring(player.UserId)) then
            myFolder = folder
            break
        end
    end

    if myFolder then
        for _, eggModel in ipairs(myFolder:GetChildren()) do
            for _, desc in ipairs(eggModel:GetDescendants()) do
                if desc:IsA("BasePart") or desc:IsA("Decal") or desc:IsA("Texture") then
                    if transparent then
                        desc.LocalTransparencyModifier = 1
                    else
                        desc.LocalTransparencyModifier = 0
                    end
                elseif desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
                    desc.Enabled = not transparent
                end
            end
        end
    end
end

task.spawn(function()
    local player = game.Players.LocalPlayer
    local playerFriendsFolder = workspace:WaitForChild("Live"):WaitForChild("PlayerFriends")
    
    local function hookFolder(folder)
        folder.ChildAdded:Connect(function()
            if hidePlayerEggsToggle then
                task.wait(0.1)
                setEggVisibility(true)
            end
        end)
    end

    for _, folder in ipairs(playerFriendsFolder:GetChildren()) do
        if folder.Name:find(player.Name) or folder.Name:find(tostring(player.UserId)) then
            hookFolder(folder)
        end
    end

    playerFriendsFolder.ChildAdded:Connect(folder)
end)

