-------------------------------------------------------------------
-- RARITY MAPPING & INDEX HELPER
-------------------------------------------------------------------
local rarityWeight = {
    ["Common"] = 1,
    ["Uncommon"] = 2,
    ["Rare"] = 3,
    ["Epic"] = 4,
    ["Legendary"] = 5,
    ["Mythic"] = 6,
    ["Cosmic"] = 7,
    ["Secret"] = 8,
    ["Eternal"] = 9
}

local function getEggRarityScore(eggObjName)
    local cleanName = eggObjName:gsub(" Egg$", ""):gsub("Egg$", ""):match("^%s*(.-)%s*$")
    
    local player = game.Players.LocalPlayer
    local indexContainer = player:FindFirstChild("PlayerGui") 
        and player.PlayerGui:FindFirstChild("Index") 
        and player.PlayerGui.Index:FindFirstChild("Main") 
        and player.PlayerGui.Index.Main:FindFirstChild("Container")

    if indexContainer then
        for _, zoneFolder in ipairs(indexContainer:GetChildren()) do
            local contentFolder = zoneFolder:FindFirstChild("Content")
            if contentFolder then
                for _, petFrame in ipairs(contentFolder:GetChildren()) do
                    local rarityObj = petFrame:FindFirstChild("Rarity")
                    local rarityText = rarityObj and (rarityObj:IsA("TextLabel") and rarityObj.Text or rarityObj:GetAttribute("Text"))

                    if rarityText then
                        local foundName = nil

                        -- 1. DisplayName
                        local displayNameObj = petFrame:FindFirstChild("DisplayName")
                        if displayNameObj then
                            local txt = displayNameObj:IsA("TextLabel") and displayNameObj.Text or displayNameObj:GetAttribute("Text")
                            if txt and txt ~= "???" and txt ~= "" then
                                foundName = txt
                            end
                        end

                        -- 2. ViewportFrame.WorldModel
                        if not foundName then
                            local viewport = petFrame:FindFirstChild("ViewportFrame")
                            local worldModel = viewport and viewport:FindFirstChild("WorldModel")
                            if worldModel then
                                local modelObj = worldModel:FindFirstChildOfClass("Model") or worldModel:GetChildren()[1]
                                if modelObj then
                                    foundName = modelObj.Name
                                end
                            end
                        end

                        -- 3. Fallback petFrame Name
                        if not foundName then
                            foundName = petFrame.Name
                        end

                        if foundName then
                            if foundName:lower() == cleanName:lower() or foundName:lower() == eggObjName:lower() then
                                return rarityWeight[rarityText] or 1
                            end
                        end
                    end
                end
            end
        end
    end
    return 1
end

-------------------------------------------------------------------
-- HELPER FUNCTIONS (FAST PROCESS)
-------------------------------------------------------------------
local function getEggList()
    local seenNames = {}
    local uniqueEggs = {}
    local friendsFolder = workspace:FindFirstChild("Live") and workspace.Live:FindFirstChild("Friends")
    
    if friendsFolder then
        for _, child in ipairs(friendsFolder:GetChildren()) do
            if not seenNames[child.Name] then
                seenNames[child.Name] = true
                table.insert(uniqueEggs, child.Name)
            end
        end
        
        table.sort(uniqueEggs, function(a, b)
            return a:lower() < b:lower()
        end)
    end
    
    return #uniqueEggs > 0 and uniqueEggs or { "No Eggs Found" }
end

local function teleportTo(targetCFrame)
    local char = game.Players.LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = targetCFrame
        end
    end
end

local function getEggSize(eggObj)
    if not eggObj then return 0 end
    local attrSize = eggObj:GetAttribute("ModelSize")
    if typeof(attrSize) == "Vector3" then return attrSize.Magnitude end
    if eggObj:FindFirstChild("ModelSize") then
        local ms = eggObj.ModelSize
        if typeof(ms) == "Vector3" then return ms.Magnitude
        elseif ms:IsA("Vector3Value") then return ms.Value.Magnitude end
    end
    if eggObj:IsA("Model") then
        local _, size = eggObj:GetBoundingBox()
        return size.Magnitude
    end
    return 0
end

local function processSingleEggGrab(eggObj)
    local char = game.Players.LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not eggObj or not eggObj.Parent then return false end

    isHoldingEgg = false

    local targetCF = nil
    if eggObj:IsA("Model") then
        targetCF = eggObj.PrimaryPart and eggObj.PrimaryPart.CFrame or eggObj:GetPivot()
    elseif eggObj:IsA("BasePart") then
        targetCF = eggObj.CFrame
    end

    if not targetCF then return false end

    teleportTo(targetCF)
    task.wait(0.05) -- Ditingkatkan kecepatannya

    local startTime = tick()
    while not isHoldingEgg and eggObj and eggObj.Parent do
        local prompt = eggObj:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            fireproximityprompt(prompt)
        end
        
        teleportTo(targetCF)
        task.wait(0.05) -- Loop pemanggilan prompt super cepat
        
        if tick() - startTime > 2 then -- Limit timeout diperpendek dari 6s ke 2s
            break
        end
    end

    if isHoldingEgg or not eggObj.Parent then
        return true
    end

    return false
end

