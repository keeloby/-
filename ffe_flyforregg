Tabs.Main:Section({ Title = "Auto Get All Eggs by Location" })

local locationsMap = {
    ["Arctic Common Ground"] = function() return workspace:FindFirstChild("Map") and workspace.Map.Ground.Arctic:FindFirstChild("Common Ground") end,
    ["Beach Uncommon Ground"] = function() return workspace:FindFirstChild("Map") and workspace.Map.Ground.Beach:FindFirstChild("Uncommon Ground") end,
    ["Deep Ocean"] = function() return workspace:FindFirstChild("Map") and workspace.Map.Ground:FindFirstChild("Deep Ocean") end,
    ["Desert Common Ground"] = function() return workspace:FindFirstChild("Map") and workspace.Map.Ground.Desert:FindFirstChild("Common Ground") end,
    ["Forest Common Ground"] = function() return workspace:FindFirstChild("Map") and workspace.Map.Ground.Forest:FindFirstChild("Common Ground") end,
    ["Ground Index 6"] = function() return workspace:FindFirstChild("Map") and workspace.Map.Ground:GetChildren()[6] end,
    ["Ground Index 7"] = function() return workspace:FindFirstChild("Map") and workspace.Map.Ground:GetChildren()[7] end,
}

local locationNames = {
    "Arctic Common Ground",
    "Beach Uncommon Ground",
    "Deep Ocean",
    "Desert Common Ground",
    "Forest Common Ground",
    "Ground Index 6",
    "Ground Index 7"
}

local selectedLocationKey = nil
local autoFarmLocToggle = false

local function getLocationPosition(locObj)
    if not locObj then return nil end
    if locObj:IsA("Model") then
        return locObj.PrimaryPart and locObj.PrimaryPart.Position or locObj:GetPivot().Position
    elseif locObj:IsA("BasePart") then
        return locObj.Position
    end
    return nil
end

local function getEggPosition(eggObj)
    if not eggObj then return nil end
    if eggObj:IsA("Model") then
        return eggObj.PrimaryPart and eggObj.PrimaryPart.Position or eggObj:GetPivot().Position
    elseif eggObj:IsA("BasePart") then
        return eggObj.Position
    end
    return nil
end

Tabs.Main:Dropdown({
    Title = "Select Location",
    Values = locationNames,
    Value = nil,
    Callback = function(option)
        selectedLocationKey = option
    end
})

Tabs.Main:Toggle({
    Title = "Auto Farm Location Eggs",
    Value = false,
    Callback = function(state)
        autoFarmLocToggle = state
        task.spawn(function()
            local sessionGrabbedCount = 0

            while autoFarmLocToggle do
                if selectedLocationKey and locationsMap[selectedLocationKey] then
                    local locObj = locationsMap[selectedLocationKey]()
                    local locPos = getLocationPosition(locObj)
                    
                    if locPos and friendsFolder then
                        local eggListSorted = friendsFolder:GetChildren()
                        table.sort(eggListSorted, function(a, b)
                            return a.Name:lower() < b.Name:lower()
                        end)

                        for _, eggObj in ipairs(eggListSorted) do
                            if not autoFarmLocToggle then break end
                            
                            local eggPos = getEggPosition(eggObj)
                            if eggPos then
                                local distance = (locPos - eggPos).Magnitude
                                if distance <= 150 then
                                    local success = processSingleEggGrab(eggObj)
                                    if success then
                                        sessionGrabbedCount = sessionGrabbedCount + 1
                                    end

                                    if sessionGrabbedCount >= 5 then
                                        teleportTo(SafeCFrame)
                                        task.wait(1)
                                        sessionGrabbedCount = 0
                                    else
                                        task.wait(0.1)
                                    end
                                end
                            end
                        end
                    end
                end
                task.wait(0.5)
            end
        end)
    end
})

