local friendsFolder = workspace:WaitForChild("Live"):WaitForChild("Friends")
local updatePending = false

local function triggerRefresh()
    if updatePending then return end
    updatePending = true

    task.delay(0.5, function()
        pcall(function()
            local newList = getEggList()
            if eggDropdown.Refresh then
                eggDropdown:Refresh(newList)
            elseif eggDropdown.SetValues then
                eggDropdown:SetValues(newList)
            end
        end)
        updatePending = false
    end)
end

friendsFolder.ChildAdded:Connect(triggerRefresh)
friendsFolder.ChildRemoved:Connect(triggerRefresh)

Tabs.Main:Input({
    Title = "Target Quantity",
    Placeholder = "Jumlah egg yg mau diambil (misal: 10)",
    Callback = function(text)
        eggAmountToGet = tonumber(text) or 1
    end
})

Tabs.Main:Button({
    Title = "Get Selected Eggs",
    Callback = function()
        if not selectedEgg then return end

        task.spawn(function()
            local char = game.Players.LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local originalCF = hrp.CFrame
            local grabbedCount = 0

            for _, eggObj in ipairs(friendsFolder:GetChildren()) do
                if eggObj.Name == selectedEgg and eggObj.Parent then
