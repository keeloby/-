Tabs.Main:Section({ Title = "Single Egg Farm" })

local selectedEgg = nil
local eggAmountToGet = 1

local eggDropdown = Tabs.Main:Dropdown({
    Title = "Select Egg",
    Values = getEggList(),
    Value = nil,
    Callback = function(option)
        selectedEgg = option
    end
